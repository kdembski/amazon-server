generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model AmazonAdCategory {
  id        Int        @id @default(autoincrement())
  name      String     @unique(map: "name_UNIQUE") @db.VarChar(63)
  createdAt DateTime   @db.Timestamp(2)
  updatedAt DateTime   @db.Timestamp(2)
  scrapedAt DateTime?  @db.Timestamp(2)
  active      Boolean            @default(false)
  ads         AmazonAd[]
  exclusionRules AmazonExclusionRule[]
}

model AmazonAd {
  id            Int              @id @default(autoincrement())
  asin          String           @unique(map: "asin_UNIQUE") @db.VarChar(63)
  categoryId    Int
  createdAt     DateTime         @db.Timestamp(2)
  updatedAt     DateTime         @db.Timestamp(2)
  scrapedAt     DateTime?        @db.Timestamp(2)
  image         String           @db.VarChar(255)
  name          String           @db.VarChar(255)
  excluded      Boolean?
  category      AmazonAdCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade, map: "amazon_ad_category_id_fk")
  AmazonAdPrice AmazonAdPrice[]

  @@index([categoryId], map: "amazon_ad_category_id_fk_idx")
  @@index([excluded, scrapedAt], map: "amazon_ad_excluded_scraped_at_idx")
}

model AmazonAdPrice {
  id           Int      @id @default(autoincrement())
  adId         Int
  countryId    Int
  value        Decimal  @db.Decimal(9, 2)
  dispatchFrom String?  @db.VarChar(63)
  createdAt    DateTime @db.Timestamp(2)
  updatedAt    DateTime @db.Timestamp(2)
  ad           AmazonAd      @relation(fields: [adId], references: [id], onDelete: Cascade, map: "amazon_ad_price_ad_id_fk")
  country      AmazonCountry @relation(fields: [countryId], references: [countryId], onDelete: Cascade, map: "amazon_ad_price_amazon_country_id_fk")

  @@index([countryId], map: "amazon_ad_price_country_id_fk")
  @@index([adId, countryId, createdAt], map: "amazon_ad_price_ad_id_country_id_created_at_idx")
}

model Country {
  id            Int             @id @default(autoincrement())
  name          String          @db.VarChar(63)
  code          String          @unique(map: "country_code_UNIQUE") @db.VarChar(63)
  currencyId    Int
  createdAt     DateTime        @db.Timestamp(2)
  updatedAt     DateTime        @db.Timestamp(2)
  AmazonCountry AmazonCountry?
  currency      Currency        @relation(fields: [currencyId], references: [id], onDelete: Cascade, map: "country_currency_id_fk")

  @@index([currencyId], map: "country_currency_id_fk")
}

model AmazonCountry {
  countryId     Int             @id
  tld           String          @db.VarChar(15)
  scraped       Boolean
  active        Boolean
  proxyType     String          @db.VarChar(15)
  priority      Int
  createdAt     DateTime        @db.Timestamp(2)
  updatedAt     DateTime        @db.Timestamp(2)
  country       Country         @relation(fields: [countryId], references: [id], onDelete: Cascade, map: "amazon_country_country_id_fk")
  AmazonAdPrice AmazonAdPrice[]
}

model Currency {
  id                 Int                    @id @default(autoincrement())
  name               String                 @db.VarChar(63)
  code               String                 @unique(map: "currency_code_UNIQUE") @db.VarChar(63)
  symbol             String                 @db.VarChar(63)
  createdAt          DateTime               @db.Timestamp(2)
  updatedAt          DateTime               @db.Timestamp(2)
  country            Country[]
  exchangeRateSource CurrencyExchangeRate[] @relation("ExchangeRateSource")
  exchangeRateTarget CurrencyExchangeRate[] @relation("ExchangeRateTarget")
}

model CurrencyExchangeRate {
  id        Int      @id @default(autoincrement())
  sourceId  Int
  targetId  Int
  createdAt DateTime @db.Timestamp(2)
  updatedAt DateTime @db.Timestamp(2)
  value     Decimal  @db.Decimal(9, 2)
  source    Currency @relation("ExchangeRateSource", fields: [sourceId], references: [id], onDelete: Cascade, map: "currency_exchange_rate_source_id_fk")
  target    Currency @relation("ExchangeRateTarget", fields: [targetId], references: [id], onDelete: Cascade, map: "currency_exchange_rate_target_id_fk")

  @@unique([sourceId, targetId], map: "unique_exchange_rate_idx")
  @@index([targetId], map: "currency_exchange_rate_target_id_fk")
}

enum Marketplace {
  amazon
}

enum ActivityEventType {
  ad_scraped
  conversion_error_sent
  pricing_error_sent
}

model ActivityEvent {
  id          Int               @id @default(autoincrement())
  type        ActivityEventType
  marketplace Marketplace
  data        Json
  createdAt   DateTime          @db.Timestamp(2)

  @@index([type, createdAt])
}

enum SystemLogLevel {
  error
  warn
  info
}

model SystemLog {
  id        Int            @id @default(autoincrement())
  level     SystemLogLevel
  source    String         @db.VarChar(63)
  message   String         @db.Text
  context   Json?
  createdAt DateTime       @db.Timestamp(2)

  @@index([createdAt])
  @@index([level, createdAt])
  @@index([source, createdAt])
}

model AmazonExclusionRule {
  id         Int               @id @default(autoincrement())
  value      String            @db.VarChar(63)
  categoryId Int?
  createdAt  DateTime          @db.Timestamp(2)
  category   AmazonAdCategory? @relation(fields: [categoryId], references: [id], onDelete: Cascade, map: "amazon_exclusion_rule_category_id_fk")

  @@unique([value, categoryId], map: "amazon_exclusion_rule_value_category_UNIQUE")
}

model ScraperMetric {
  id          Int         @id @default(autoincrement())
  scraper     String      @db.VarChar(63)
  marketplace Marketplace
  flow        String      @db.VarChar(15)
  metric      String      @db.VarChar(63)
  country     String?     @db.VarChar(7)
  outcome     String?     @db.VarChar(31)
  value       Float
  periodStart DateTime    @db.Timestamp(2)
  createdAt   DateTime    @db.Timestamp(2)

  @@index([periodStart, metric])
}

model ScraperConfig {
  scraper     String   @id @db.VarChar(63)
  concurrency Int      @default(10)
  rps         Int      @default(0)
  batchSize   Int      @default(50)
  updatedAt   DateTime @updatedAt @db.Timestamp(2)
}
