model AmazonAdCategory {
  id        Int        @id @default(autoincrement())
  name      String     @unique(map: "name_UNIQUE") @db.VarChar(63)
  createdAt DateTime   @db.Timestamp(2)
  updatedAt DateTime   @db.Timestamp(2)
  scrapedAt DateTime?  @db.Timestamp(2)
  active      Boolean            @default(false)
  ads         AmazonAd[]
  exclusionRules AmazonExclusionRule[]
}

model AmazonAd {
  id            Int              @id @default(autoincrement())
  asin          String           @unique(map: "asin_UNIQUE") @db.VarChar(63)
  categoryId    Int
  createdAt     DateTime         @db.Timestamp(2)
  updatedAt     DateTime         @db.Timestamp(2)
  scrapedAt     DateTime?        @db.Timestamp(2)
  image         String           @db.VarChar(255)
  name          String           @db.VarChar(512)
  excluded      Boolean?
  category      AmazonAdCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade, map: "amazon_ad_category_id_fk")
  AmazonAdPrice AmazonAdPrice[]
  outlierReports AmazonCountryOutlierReport[]
  missing        AmazonAdMissing[]

  @@index([categoryId], map: "amazon_ad_category_id_fk_idx")
  @@index([excluded, scrapedAt], map: "amazon_ad_excluded_scraped_at_idx")
}

model AmazonAdPrice {
  id           Int      @id @default(autoincrement())
  adId         Int
  countryId    Int
  value        Decimal  @db.Decimal(9, 2)
  dispatchFrom String?  @db.VarChar(63)
  createdAt    DateTime @db.Timestamp(2)
  updatedAt    DateTime @db.Timestamp(2)
  ad           AmazonAd      @relation(fields: [adId], references: [id], onDelete: Cascade, map: "amazon_ad_price_ad_id_fk")
  country      AmazonCountry @relation(fields: [countryId], references: [countryId], onDelete: Cascade, map: "amazon_ad_price_amazon_country_id_fk")

  @@index([countryId], map: "amazon_ad_price_country_id_fk")
  @@index([adId, countryId, createdAt], map: "amazon_ad_price_ad_id_country_id_created_at_idx")
  @@index([createdAt], map: "amazon_ad_price_created_at_idx")
}

model AmazonCountry {
  countryId     Int             @id
  tld           String          @db.VarChar(15)
  scraped       Boolean
  active        Boolean
  createdAt     DateTime        @db.Timestamp(2)
  updatedAt     DateTime        @db.Timestamp(2)
  country       Country         @relation(fields: [countryId], references: [id], onDelete: Cascade, map: "amazon_country_country_id_fk")
  AmazonAdPrice AmazonAdPrice[]
  outlierReports AmazonCountryOutlierReport[]
  routes         AmazonCountryRoute[]
}

model AmazonCountryRoute {
  id          Int               @id @default(autoincrement())
  countryId   Int
  priority    Int
  proxyType   String            @db.VarChar(15)
  pdpSource   String            @db.VarChar(15)
  maxAttempts Int
  createdAt   DateTime          @db.Timestamp(2)
  updatedAt   DateTime          @db.Timestamp(2)
  country     AmazonCountry     @relation(fields: [countryId], references: [countryId], onDelete: Cascade, map: "amazon_country_route_country_id_fk")
  missing     AmazonAdMissing[]

  @@unique([countryId, priority], map: "amazon_country_route_country_id_priority_UNIQUE")
}

model AmazonCountryOutlierReport {
  adId      Int
  countryId Int
  value     Decimal       @db.Decimal(9, 2)
  updatedAt DateTime      @updatedAt @db.Timestamp(2)
  ad        AmazonAd      @relation(fields: [adId], references: [id], onDelete: Cascade, map: "amazon_country_outlier_report_ad_id_fk")
  country   AmazonCountry @relation(fields: [countryId], references: [countryId], onDelete: Cascade, map: "amazon_country_outlier_report_country_id_fk")

  @@id([adId, countryId])
  @@index([countryId], map: "amazon_country_outlier_report_country_id_fk")
}

model AmazonAdMissing {
  adId      Int
  routeId   Int
  createdAt DateTime           @db.Timestamp(2)
  ad        AmazonAd           @relation(fields: [adId], references: [id], onDelete: Cascade, map: "amazon_ad_missing_ad_id_fk")
  route     AmazonCountryRoute @relation(fields: [routeId], references: [id], onDelete: Cascade, map: "amazon_ad_missing_route_id_fk")

  @@id([adId, routeId])
  @@index([routeId], map: "amazon_ad_missing_route_id_fk")
  @@index([createdAt], map: "amazon_ad_missing_created_at_idx")
}

model AmazonExclusionRule {
  id         Int               @id @default(autoincrement())
  value      String            @db.VarChar(512)
  categoryId Int?
  inverted   Boolean
  createdAt  DateTime          @db.Timestamp(2)
  category   AmazonAdCategory? @relation(fields: [categoryId], references: [id], onDelete: Cascade, map: "amazon_exclusion_rule_category_id_fk")

  @@unique([value, categoryId], map: "amazon_exclusion_rule_value_category_UNIQUE")
}
