    "cron": "^4.4.0",
    "date-fns": "^4.4.0",
    "discord.js": "^14.28.1",
    "express": "^5.3.0",
    "lodash": "^4.18.1",
    "node-os-utils": "^3.1.0"
  },
  "devDependencies": {
    "@testcontainers/mysql": "^12.2.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/lodash": "^4.17.27",
