    "lodash": "^4.17.21",
    "node-os-utils": "^1.3.7"
  },
  "devDependencies": {
    "@testcontainers/mysql": "^12.2.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/lodash": "^4.17.14",
    "@types/node": "^22.10.7",
    "@types/node-os-utils": "^1.3.4",
    "@types/supertest": "^7.2.1",
