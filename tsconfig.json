{
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "outDir": "dist",
    "module": "es2022",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "target": "ES2022",
    "lib": ["ES2022"],
    "skipLibCheck": true,
    "paths": {
      "@/*": ["./src/*"],
      "@@prisma/*": ["./prisma/*"]
    }
  },
  "include": ["src/**/*", "tests/**/*", "vite.config.ts", "vitest.config.ts"]
}
